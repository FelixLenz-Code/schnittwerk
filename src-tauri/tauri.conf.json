{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Schnittwerk",
  "version": "0.8.4",
  "identifier": "de.schnittwerk.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && cargo build --release -p schnittwerk-mcp -p schnittwerk-cli && python3 -I scripts/third-party-notices.py",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Schnittwerk",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 640,
        "maximized": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: schnittwerk: http://schnittwerk.localhost",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "font-src": "'self' data:",
        "object-src": "'none'",
        "base-uri": "'none'",
        "frame-src": "'none'",
        "form-action": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: schnittwerk: http://schnittwerk.localhost",
        "connect-src": "'self' ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420",
        "font-src": "'self' data:",
        "object-src": "'none'",
        "base-uri": "'none'",
        "frame-src": "'none'",
        "form-action": "'none'"
      },
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb"
    ],
    "category": "GraphicsAndDesign",
    "shortDescription": "Schneideplotter-Software für Linux",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libusb-1.0-0",
          "cups-client",
          "poppler-utils"
        ],
        "files": {
          "/usr/lib/udev/rules.d/70-silhouette.rules": "../packaging/70-silhouette.rules",
          "/usr/bin/schnittwerk-mcp": "../target/release/schnittwerk-mcp",
          "/usr/bin/schnittwerk-cli": "../target/release/schnittwerk-cli",
          "/usr/share/doc/schnittwerk/THIRD_PARTY_LICENSES.txt": "../target/third-party-licenses.txt",
          "/usr/share/doc/schnittwerk/copyright": "../LICENSE"
        }
      }
    },
    "longDescription": "Schnittwerk ist eine Linux-Software für Silhouette-Schneideplotter (Portrait 3): Bilder tracen, Sticker mit Print & Cut erstellen und direkt per USB schneiden."
  }
}
